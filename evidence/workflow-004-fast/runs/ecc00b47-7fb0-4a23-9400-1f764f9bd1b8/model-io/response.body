{"choices":[{"finish_reason":"stop","index":0,"logprobs":null,"message":{"content":"{\n    \"files\": [\n        {\n            \"path\": \"solution.py\",\n            \"content\": \"def merge_intervals(intervals):\\n    if not intervals:\\n        return []\\n\\n    # Sort intervals by their start value\\n    intervals.sort(key=lambda x: x[0])\\n\\n    merged = [intervals[0]]\\n    for current in intervals[1:]:\\n        last_merged = merged[-1]\\n        if current[0] <= last_merged[1]:\\n            # Merge overlapping intervals\\n            merged[-1] = (last_merged[0], max(last_merged[1], current[1]))\\n        else:\\n            # Add non-overlapping interval\\n            merged.append(current)\\n\\n    return merged\"\n        }\n    ]\n}","role":"assistant","tool_calls":[]}}],"created":1791619305,"model":"qwen25-coder-7b-int4","object":"chat.completion","usage":{"prompt_tokens":554,"completion_tokens":167,"total_tokens":721}}